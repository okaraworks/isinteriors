# ─── Site ──────────────────────────────────────────────────────────────
# Public canonical URL, used for SEO tags. No trailing slash.
VITE_SITE_URL=https://isoeinteriors.web.app
# "browser" (default, clean URLs — needs SPA rewrites, already set in firebase.json) or "hash"
VITE_ROUTER=browser

# ─── Firebase (Spark / free plan) ─────────────────────────────────────
# Firebase console → Project settings → Your apps → Web app → SDK config.
# Leave blank to run the site with a local demo submit handler (nothing is sent).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# App Check (free). reCAPTCHA v3 site key from https://www.google.com/recaptcha/admin
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Photo uploads.
#   "firestore" (default, free Spark plan): photos are resized in the browser and
#               stored as small JPEG chunks in Firestore.
#   "storage":  original photos go to Cloud Storage. Requires the Blaze plan.
VITE_PHOTO_UPLOAD_MODE=firestore

# ─── Studio contact (shown on the site once set) ──────────────────────
VITE_STUDIO_PHONE=
VITE_STUDIO_EMAIL=
# WhatsApp click-to-chat: international format, digits only (e.g. 2348012345678)
VITE_WHATSAPP_NUMBER=

# ─── Booking calendar (free) — set ONE ────────────────────────────────
# Cal.com: the part after cal.com/, e.g. isoe-interiors/consultation
VITE_CAL_LINK=
# Calendly: full event URL, e.g. https://calendly.com/isoe-interiors/consultation
VITE_CALENDLY_URL=

# ─── Email alert for every inquiry (free) — set ONE ───────────────────
# EmailJS: Account → Public key; Email Services → Service ID; Email Templates → Template ID
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
# Formspree: the ID from https://formspree.io/f/<ID>
VITE_FORMSPREE_FORM_ID=

# ─── Cloudinary (free): full-size inquiry photos + project images ─────
VITE_CLOUDINARY_CLOUD_NAME=
# Settings → Upload → Upload presets → Add (Signing mode: Unsigned)
VITE_CLOUDINARY_UPLOAD_PRESET=

# ─── SEO & insights (free) ────────────────────────────────────────────
# Google Search Console → Add property → URL prefix → HTML tag → the content="…" value
VITE_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → HTML Meta Tag → the content="…" value
VITE_BING_SITE_VERIFICATION=
# Microsoft Clarity → Settings → Overview → Project ID (loads only after consent)
VITE_CLARITY_PROJECT_ID=
