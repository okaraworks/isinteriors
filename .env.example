# ─── Site ──────────────────────────────────────────────────────────────
# Public canonical URL, used for SEO tags. No trailing slash.
VITE_SITE_URL=https://www.example.com
# "browser" (default, clean URLs — needs SPA rewrites, already set in firebase.json) or "hash"
VITE_ROUTER=browser

# ─── Firebase (Spark / free plan) ─────────────────────────────────────
# Firebase console → Project settings → Your apps → Web app → SDK config.
# Leave blank to run the site with a local demo submit handler (nothing is sent).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# App Check (free). reCAPTCHA v3 site key from https://www.google.com/recaptcha/admin
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Photo uploads.
#   "firestore" (default, free Spark plan): photos are resized in the browser and
#               stored as small JPEG chunks in Firestore.
#   "storage":  original photos go to Cloud Storage. Requires the Blaze plan.
VITE_PHOTO_UPLOAD_MODE=firestore
